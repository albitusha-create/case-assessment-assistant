# Copy to .env for local runs. Values are endpoints and names only: no keys.
# Auth uses DefaultAzureCredential (az login locally, managed identity in Azure).
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=case-chunks
AZURE_DOCINTEL_ENDPOINT=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_COSMOS_ENDPOINT=
APIM_GATEWAY_URL=
CHAT_MODEL_DEPLOYMENT=
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small
