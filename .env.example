# Local runs read the values azd writes after `azd provision`:
#   azd env get-values > .env
# Values are endpoints and names only, never keys. Auth uses
# DefaultAzureCredential (az login locally, managed identity in Azure).
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
CHAT_MODEL_DEPLOYMENT=gpt-5.4-mini
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small
AZURE_SEARCH_ENDPOINT=
AZURE_DOCINTEL_ENDPOINT=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=case-documents
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=caa
AZURE_KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=
